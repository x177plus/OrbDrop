<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- mDNS 发现（F-10）在安卓上要额外两样东西（P1-13①）：
         ① `CHANGE_WIFI_MULTICAST_STATE` —— 拿 Wi-Fi 组播锁的权限。安卓的 Wi-Fi 驱动默认
            **过滤组播**，不拿锁就收不到 mDNS 的组播应答（本机发得出去、收不回来），
            表现是"设备列表永远是空的"，只能手动敲 IP；
         ② `ACCESS_WIFI_STATE` —— `getSystemService(WIFI_SERVICE)` 本身要它。
         锁在 `OrbDropService` 里申请/释放（生命周期 = "应用在局域网上活着"）：界面会先走
         （常驻服务还在、进程还在），锁跟着界面走就会在那一刻默默失效 —— 设备表不再更新、
         地址学不到，而且看不出任何异常。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 收件里的 APK 点一下就能装（F-109）：`.apk` 那条走 `ACTION_VIEW` +
         `application/vnd.android.package-archive`，落到系统安装器上（见 `FileOpenPlugin.kt`）。

         这条权限不是给"自己开 `PackageInstaller` 会话直接装"用的（那条路我们不走），而是：
         **只有声明了它的应用才出现在「设置 → 应用 → 特殊应用权限 → 安装未知应用」那张列表里**
         —— Android 8 起那个开关默认关着，装不上时用户得能自己打开它。它也是普通安装权限
         （不是运行时弹框那种），声明本身不弹任何东西；首次点安装时系统自己引用户去开。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 常驻前台服务（F-81）：界面切后台之后进程要活着，否则长连接与服务器一起停，
         谁推来的文件都收不到（推送不排队，见 F-53）。

         类型选 `connectedDevice`（"与外部设备保持连接"）而不是 `dataSync`：`dataSync` 在
         Android 15（targetSdk 35+）上有**每 24 小时只有 6 小时**的硬上限 —— 到点系统回调
         `Service.onTimeout`，不主动停就抛 `RemoteServiceException` 把进程崩掉（见
         `OrbDropService.onTimeout` 的注释）；`connectedDevice` **没有这个上限**，这才对得上
         "一直在线"。它的运行时前提是清单里声明 `CHANGE_NETWORK_STATE / CHANGE_WIFI_STATE /
         CHANGE_WIFI_MULTICAST_STATE / NFC / TRANSMIT_IR` 之一（见下面 mDNS 那一段，
         我们已经有 `CHANGE_WIFI_MULTICAST_STATE`，天然满足）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+ 的通知权限：没有它前台服务照旧能跑，但那一条常驻通知不会显示。
         运行时在 MainActivity 里申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 电池优化白名单（F-87）：**只为了让界面能直接弹系统的那个"允许后台运行"对话框**
         （`ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS`）—— 没有这条权限的话那条 action 当场
         `SecurityException`，只能退到白名单列表页让用户自己找。
         它是普通权限（安装即授予，不弹任何东西），真正弹框的是那个 action 本身。
         在 Google Play 上这条权限属于**受限用法**（政策要求应用确实需要常驻）——本应用不经商店
         分发，且承诺就是"后台保持在线"（见 `OrbDropService` 的类注释）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 监听网络变化（`ConnectivityManager.registerNetworkCallback`）：Wi-Fi 关掉再打开时，
         系统会把组播锁/Wi-Fi 锁收回去，得在网络恢复的那一刻重新拿回来，否则 mDNS 又聋了
         （见 `OrbDropService.watchWifi`）。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 高性能 Wi-Fi 锁（`WifiManager.createWifiLock().acquire()`）要它 —— 没有的话
         `acquire()` 直接抛 `SecurityException`："Neither user … nor current process has
         android.permission.WAKE_LOCK"。普通权限，安装即授予，不弹框。
         注意：**组播锁**不需要它（那条走 `CHANGE_WIFI_MULTICAST_STATE`），只有 Wi-Fi 锁要。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- 包可见性（Android 11+，F-119）：不声明的话 `queryIntentActivities` / `getInstalledPackages`
         只回极少数几项（常常只有本应用自己）——「发送应用」那张表会是空的，而且看不出哪里错了。

         用 **intent 签名**（MAIN + LAUNCHER）而不是 `QUERY_ALL_PACKAGES`：要的正是"有桌面图标的
         那些" —— 用户说"应用"指的就是它们（与系统"设置 → 应用"里那一列同一个口径），而
         `QUERY_ALL_PACKAGES` 会把服务类的包一起放进来（表里全是噪声），它本身还是 Play 的受限权限
         （本应用不经商店分发，但没必要背这一条）。清单声明，不弹任何权限框。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.orbdrop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- 竖屏锁定：移动端界面是竖屏布局，而设备（模拟器/平板）开机时的显示方向可能是横的 ——
             不锁的话应用一启动就跟着横过来（`mCurrentAppOrientation=UNSPECIFIED` 就是没锁的样子）。
             注意 `configChanges` 里的 `orientation` 仍要留着：锁的是**应用**的方向，
             屏幕本身的方向变化（分屏、外接屏）照样得由我们自己吞下、不让 Activity 重建。

             `windowSoftInputMode="adjustResize"`：**不是**让它去缩窗口（`enableEdgeToEdge()` 之后
             窗口不缩了），而是让软键盘的 inset 派发得下来 —— 少了它 `WindowInsetsCompat.Type.ime()`
             恒为 0，MainActivity 里那段"给 WebView 让出键盘位置"就是空转（实测：键盘弹起、
             输入框仍被压在键盘底下）。 -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- 常驻前台服务（F-81）：让进程在后台活着，长连接与服务器才不会跟着界面一起停。
             `foregroundServiceType="connectedDevice"`（见上面权限处的理由：无 6 小时上限）。
             `stopWithTask` 默认 false ＝ 用户从最近任务划掉也不停服务，保持默认即可。 -->
        <service
            android:name=".OrbDropService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
