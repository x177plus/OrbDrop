<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.orbdrop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 与 values/themes.xml 同一份（夜间限定符下这个 style 会**整份替换**基版，
