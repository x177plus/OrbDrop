{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbDrop",
  "version": "0.1.0",
  "identifier": "com.orbdrop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OrbDrop",
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "width": 90,
        "height": 90,
        "minWidth": 90,
        "minHeight": 90,
        "center": true,
        "resizable": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "OrbDrop"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}