{
  "name": "orbdrop",
  "version": "0.1.1",
  "description": "OrbDrop — LAN file sharing tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:mobile": "vite --mode mobile",
    "build:mobile": "vite build --mode mobile",
    "tokens:gen": "node scripts/gen-color-tokens.mjs src/mobile/mobile.css && node scripts/gen-color-tokens.mjs src/styles/main.css",
    "tokens:check": "node scripts/gen-color-tokens.mjs --check src/mobile/mobile.css && node scripts/gen-color-tokens.mjs --check src/styles/main.css",
    "check:compat": "node scripts/check-compat.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:snapshot": "node scripts/test-snapshot-order.mjs",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "mac:dev": "tauri dev",
    "mac:build": "tauri build --target universal-apple-darwin",
    "mac:build:arm64": "tauri build --target aarch64-apple-darwin",
    "mac:build:x64": "tauri build --target x86_64-apple-darwin",
    "mac:artifact": "node scripts/macos-artifact.mjs",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "android:build:split": "tauri android build --apk --aab --split-per-abi",
    "android:build:debug": "tauri android build --apk --debug",
    "android:build:arm64": "tauri android build --apk --target aarch64",
    "android:release": "tauri android build --apk --target aarch64 && node scripts/install-android.mjs",
    "android:install": "node scripts/install-android.mjs",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "release:local": "node scripts/release.mjs --local --skip-build",
    "mirror": "node scripts/dev-mirror.mjs",
    "commit": "omp commit -c \"摘要首词用英文过去式动词（Added、Fixed、Updated），其余摘要与全部明细用简体中文\"",
    "commit:dry": "npm run commit -- --dry-run",
    "legacy:gen": "node scripts/gen-legacy-gap.mjs",
    "legacy:check": "node scripts/gen-legacy-gap.mjs --check"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "acorn": "^8.18.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
